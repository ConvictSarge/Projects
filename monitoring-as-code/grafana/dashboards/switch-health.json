{
  "title": "Switch health",
  "uid": "switch-health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "tags": ["network"],
  "panels": [
    {"id": 1, "type": "timeseries", "title": "PoE power used vs budget (W)", "gridPos": {"x": 0, "y": 0, "w": 16, "h": 9},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "watt", "min": 0}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "switch_poe_consumption_watts{pse_group=\"1\"}", "legendFormat": "used"},
       {"refId": "B", "expr": "switch_poe_budget_watts{pse_group=\"1\"}", "legendFormat": "budget"}]},
    {"id": 2, "type": "gauge", "title": "PoE load now (% of budget)", "gridPos": {"x": 16, "y": 0, "w": 8, "h": 9},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []},
     "targets": [{"refId": "A", "expr": "100 * switch_poe_consumption_watts{pse_group=\"1\"} / switch_poe_budget_watts{pse_group=\"1\"}"}]},
    {"id": 3, "type": "timeseries", "title": "Switch uptime (hours) - a drop to 0 is a reboot", "gridPos": {"x": 0, "y": 9, "w": 16, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "h", "min": 0}, "overrides": []},
     "targets": [{"refId": "A", "expr": "switch_uptime_ticks / 100 / 3600", "legendFormat": "uptime"}]},
    {"id": 4, "type": "stat", "title": "Reboots in range", "gridPos": {"x": 16, "y": 9, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(resets(switch_uptime_ticks[$__range]))", "instant": true}]},
    {"id": 5, "type": "logs", "title": "Switch syslog", "gridPos": {"x": 0, "y": 17, "w": 24, "h": 10},
     "datasource": {"type": "loki", "uid": "loki"},
     "options": {"sortOrder": "Descending", "wrapLogMessage": true},
     "targets": [{"refId": "A", "expr": "{job=\"switch-syslog\"} != \"Source relearning\""}]}
  ]
}
